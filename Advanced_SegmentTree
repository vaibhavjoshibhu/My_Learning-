# 🧱 PART 1: SEGMENT TREE

---

# 3. Structure

```cpp id="st2"
int seg[4 * N];
```

---

# 4. Build Tree ⭐

```cpp id="st3"
void build(int idx, int l, int r, vector<int>& arr){

    if(l == r){
        seg[idx] = arr[l];
        return;
    }

    int mid = (l + r) / 2;

    build(2*idx, l, mid, arr);
    build(2*idx+1, mid+1, r, arr);

    seg[idx] = seg[2*idx] + seg[2*idx+1];
}
```

---

# 5. Range Query ⭐

```cpp id="st4"
int query(int idx, int l, int r, int ql, int qr){

    if(qr < l || r < ql)
        return 0;

    if(ql <= l && r <= qr)
        return seg[idx];

    int mid = (l + r) / 2;

    return query(2*idx, l, mid, ql, qr)
         + query(2*idx+1, mid+1, r, ql, qr);
}
```

---

# 6. Point Update ⭐

```cpp id="st5"
void update(int idx, int l, int r, int pos, int val){

    if(l == r){
        seg[idx] = val;
        return;
    }

    int mid = (l + r) / 2;

    if(pos <= mid)
        update(2*idx, l, mid, pos, val);
    else
        update(2*idx+1, mid+1, r, pos, val);

    seg[idx] = seg[2*idx] + seg[2*idx+1];
}
```

---

# 7. Complexity

```text id="st6"
Build   → O(n)
Query   → O(log n)
Update  → O(log n)
Space   → O(4n)
```

